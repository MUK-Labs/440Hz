<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#216957</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F3EB</item>
        <!-- Android 8.0 has light navigation icons, so use a dark background. -->
        <item name="android:navigationBarColor">#216957</item>
        <item name="android:windowBackground">#F4F3EB</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
